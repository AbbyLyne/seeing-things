# Quarto build output (published to gh-pages, not committed to main)
_site/
.quarto/
**/*.quarto_ipynb
# NOTE: _freeze/ IS committed, so don't ignore it

# Data that can be rebuilt
data/seeing_things.duckdb
data/seeing_things.duckdb.wal
data/raw/fastf1_cache/

# Environments
.venv/
renv/library/
renv/staging/
.Rproj.user/
.Rhistory
__pycache__/

# Obsidian's own settings (change constantly; not part of the notes)
vault/.obsidian/

# Secrets and OS clutter
.env
.DS_Store

# Cloud credentials (never commit)
*.p8
*.pem
*service-account*.json
profiles.yml
orchestration/airflow_settings.yaml
orchestration/.env

# dbt build output
dbt/target/
dbt/logs/
dbt/dbt_packages/
